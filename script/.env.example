# A read-only --once keeper check needs only RPC_URL and PAYMASTER_ADDRESS.
RPC_URL=https://robinhood-testnet.drpc.org
PAYMASTER_ADDRESS=

# Use a separate, low-funded hot wallet. Never put a treasury or governor key
# here. The keeper only pays gas for the permissionless refill() call.
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_MS=60000
