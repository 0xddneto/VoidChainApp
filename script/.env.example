# The key that deploys the collection on testnet. The real .env is gitignored —
# a key that reaches a repository is a key that has to be replaced.
DEPLOYER_PRIVATE_KEY=0x...

# Optional. Defaults to the public endpoint, which slips under load; a dedicated
# provider makes deploying 1,111 deeds considerably less painful.
PARENT_RPC=https://robinhood-testnet.drpc.org
