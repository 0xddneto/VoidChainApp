# Where the indexer writes. The default matches the Postgres in
# docker-compose.yml, so this file is only needed to point somewhere else.
DATABASE_URL=postgres://voidscan:voidscan@localhost:5433/voidscan

# Optional. Defaults to the public endpoint recorded in the deployment. The
# public one throttles under load; a dedicated provider keeps the feed current.
PARENT_RPC=https://robinhood-testnet.drpc.org
