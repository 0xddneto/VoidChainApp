# The database the indexer fills. The site also writes signed profiles and the
# relayer's duplicate/rate-limit reservations.
DATABASE_URL=postgres://voidscan:voidscan@localhost:5433/voidscan

# Testnet only. Kept outside Git and used only by /api/market/sponsor to send
# a transaction after the wallet has signed a tightly bounded market request.
# Use a funded, dedicated relayer wallet before any public environment.
PAYMASTER_RELAYER_PRIVATE_KEY=0x

# Delay explorer publication by a few seconds so tip blocks are not presented
# as settled history. The long-running indexer and Vercel cron use this value.
INDEXER_CONFIRMATIONS=20
